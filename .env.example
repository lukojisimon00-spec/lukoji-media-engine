# LUKOJI MEDIA ENGINE — variables d'environnement (copier en .env, JAMAIS versionner .env)
# Phase 0 : aucun secret requis.
# Surcharges de configuration : LUKOJI_<SECTION>__<CLE>
# LUKOJI_ENCODE__CRF=18
# LUKOJI_PATHS__DB=var/lukoji.sqlite3
# LUKOJI_ROOT=/chemin/vers/lukoji-media-engine
#
# Phases ultérieures (non utilisées) — à fournir via le gestionnaire de secrets, pas dans ce fichier :
# YOUTUBE_CLIENT_ID= / YOUTUBE_CLIENT_SECRET= / META_PAGE_TOKEN= / TIKTOK_CLIENT_KEY= / ELEVENLABS_API_KEY=
